<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/headerLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/store_subtitle"
                android:textColor="@color/accent_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⟳ Sync"
            android:textColor="@color/text_primary"
            android:background="@color/bg_surface"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:hint="@string/search_hint"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@color/bg_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Category Filter Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/catAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_all"
                android:textColor="@color/text_primary"
                android:background="@color/accent_blue_dark"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/catAndroid"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_android"
                android:textColor="@color/text_muted"
                android:background="@color/bg_card"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/catPC"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_pc"
                android:textColor="@color/text_muted"
                android:background="@color/bg_card"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/catTools"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_tools"
                android:textColor="@color/text_muted"
                android:background="@color/bg_card"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/catEdu"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/category_education"
                android:textColor="@color/text_muted"
                android:background="@color/bg_card" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Status / Count Indicator -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lade Katalog..."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <!-- Apps List ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/appListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
