<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/bg_card"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/icon"
        android:contentDescription="App Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appVersionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textColor="@color/accent_blue"
                android:background="@color/bg_surface"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textSize="11sp"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/appInstallStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Installiert"
                android:textColor="@color/accent_green"
                android:background="@color/bg_surface"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textSize="11sp"
                android:visibility="gone"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/appSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Summary description..."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:maxLines="2"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/appPlatformPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android"
            android:textColor="@color/accent_amber"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <Button
            android:id="@+id/btnCardAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/install"
            android:textColor="@color/text_primary"
            android:background="@color/accent_blue_dark"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnCardVersions"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/versions_btn"
            android:textColor="@color/accent_blue"
            android:background="@color/bg_surface"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
